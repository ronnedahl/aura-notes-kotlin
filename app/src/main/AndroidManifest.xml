<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice notes are recorded with the on-device SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ (package visibility): without this, binding to the speech
         recognition service fails and SpeechRecognizer.isRecognitionAvailable()
         returns false. See developer.android.com package-visibility docs. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AuraNotes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One-tap recording home-screen widget. exported=false: it only
             receives the system's targeted APPWIDGET_UPDATE broadcast. -->
        <receiver
            android:name=".widget.AuraNotesWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aura_notes_widget_info" />
        </receiver>
    </application>

</manifest>